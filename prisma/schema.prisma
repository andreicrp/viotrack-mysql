generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Student {
  id             BigInt            @id @default(autoincrement()) @db.UnsignedBigInt
  studentId      String            @unique @map("student_id") @db.VarChar(50)
  fname          String            @db.VarChar(100)
  mname          String            @default("") @db.VarChar(100)
  lname          String            @db.VarChar(100)
  email          String            @default("") @db.VarChar(150)
  grade          String            @db.VarChar(20)
  section        String            @db.VarChar(50)
  academicYear   String            @default("2025-2026") @map("academicyear") @db.VarChar(20)
  gender         String            @default("Male") @db.VarChar(10)
  contact        String            @default("") @db.VarChar(30)
  parentName     String            @default("") @map("parent_name") @db.VarChar(150)
  parentContact  String            @default("") @map("parent_contact") @db.VarChar(30)
  address        String?           @db.Text
  image          String?           @db.LongText
  track          String            @default("JHS") @db.VarChar(50)
  strand         String            @default("JHS") @db.VarChar(100)
  createdAt      DateTime          @default(now()) @map("created_at") @db.DateTime(0)
  records        Record[]
  locations      StudentLocation[]
  meetings       Meeting[]
  smsLogs        SmsLog[]

  @@index([grade, section])
  @@index([lname, fname])
  @@map("students")
}

model Admin {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  fname      String   @db.VarChar(100)
  mname      String   @default("") @db.VarChar(100)
  lname      String   @db.VarChar(100)
  email      String   @unique @db.VarChar(150)
  password   String   @map("password_hash") @db.VarChar(255)
  role       String   @default("admin") @db.VarChar(50)
  position   String   @default("Discipline Staff") @db.VarChar(100)
  contact    String   @default("") @db.VarChar(30)
  image      String?  @db.LongText
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(0)
  @@map("admins")
}

model Teacher {
  id          BigInt     @id @default(autoincrement()) @db.UnsignedBigInt
  fname       String     @db.VarChar(100)
  mname       String     @default("") @db.VarChar(100)
  lname       String     @db.VarChar(100)
  email       String     @unique @db.VarChar(150)
  password    String     @map("password_hash") @db.VarChar(255)
  position    String     @default("Teacher I") @db.VarChar(100)
  department  String     @default("Junior High School") @db.VarChar(100)
  specialization String  @default("") @db.VarChar(150)
  contact     String     @default("") @db.VarChar(30)
  gender      String     @default("Male") @db.VarChar(10)
  image       String?    @db.LongText
  createdAt   DateTime   @default(now()) @map("created_at") @db.DateTime(0)
  advisers    Adviser[]
  @@map("teachers")
}

model Adviser {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  teacherId  BigInt   @map("teacher_id") @db.UnsignedBigInt
  gradeLevel String   @map("grade_level") @db.VarChar(20)
  classSection String @map("class_section") @db.VarChar(50)
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(0)
  teacher    Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([gradeLevel, classSection])
  @@map("advisers")
}

model Violation {
  id             BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  title          String   @db.VarChar(150)
  description    String?  @db.Text
  type           String   @default("Minor") @db.VarChar(30)
  severity       String?  @default("Minor") @db.VarChar(30)
  defaultSanction String? @map("default_sanction") @db.Text
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(0)
  records        Record[]

  @@index([type])
  @@map("violations")
}

model Record {
  id               BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  studentId        BigInt    @map("student_id") @db.UnsignedBigInt
  violationId      BigInt?   @map("violation_id") @db.UnsignedBigInt
  reportedById     BigInt?   @map("reported_by_id") @db.UnsignedBigInt
  reportedByType   String?   @default("admin") @map("reported_by_type") @db.VarChar(20)
  reportedByName   String?   @map("reported_by_name") @db.VarChar(150)
  dateReported     DateTime  @default(now()) @map("date_reported") @db.DateTime(0)
  status           String    @default("Pending") @db.VarChar(30)
  approvalStatus   String    @default("Approved") @map("approval_status") @db.VarChar(30)
  approvedBy       String?   @map("approved_by") @db.VarChar(150)
  approvedAt       DateTime? @map("approved_at") @db.DateTime(0)
  rejectedBy       String?   @map("rejected_by") @db.VarChar(150)
  rejectedAt       DateTime? @map("rejected_at") @db.DateTime(0)
  rejectionReason  String?   @map("rejection_reason") @db.Text
  sanction         String?   @db.Text
  remarks          String?   @db.Text
  resolutionNotes  String?   @map("resolution_notes") @db.Text
  resolutionDate   DateTime? @map("resolution_date") @db.DateTime(0)
  smsNotified      Boolean   @default(false) @map("sms_notified")
  createdAt        DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  student          Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  violation        Violation? @relation(fields: [violationId], references: [id], onDelete: SetNull)
  meetings         Meeting[]
  smsLogs          SmsLog[]

  @@index([status])
  @@index([approvalStatus])
  @@index([dateReported])
  @@map("records")
}

model StudentLocation {
  id             BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  studentId      BigInt   @map("student_id") @db.UnsignedBigInt
  latitude       Decimal  @db.Decimal(10, 7)
  longitude      Decimal  @db.Decimal(11, 7)
  accuracyMeters Int      @default(10) @map("accuracy_meters")
  trackingStatus String   @default("Active") @map("tracking_status") @db.VarChar(50)
  reportedBy     String   @default("System") @map("reported_by") @db.VarChar(150)
  recordedAt     DateTime @default(now()) @map("recorded_at") @db.DateTime(0)
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(0)
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, recordedAt])
  @@map("student_locations")
}

model SchoolEvent {
  id           BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  title        String   @db.VarChar(200)
  description  String?  @db.Text
  date         DateTime @db.Date
  time         String   @default("") @db.VarChar(100)
  location     String   @default("") @db.VarChar(200)
  category     String   @default("academic") @db.VarChar(50)
  categoryLabel String  @default("Academic") @map("categoryLabel") @db.VarChar(100)
  color        String   @default("#07345f") @db.VarChar(20)
  attendees    String   @default("All Students") @db.VarChar(200)
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(0)

  @@map("school_events")
}

model ActivityLog {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  userName   String   @map("user_name") @db.VarChar(150)
  userRole   String   @map("user_role") @db.VarChar(50)
  action     String   @db.VarChar(100)
  details    String?  @db.Text
  auditId    String?  @map("audit_id") @db.VarChar(80)
  ipAddress  String?  @map("ip_address") @db.VarChar(50)
  deviceInfo String?  @map("device_info") @db.VarChar(255)
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(0)

  @@index([createdAt])
  @@map("activity_logs")
}

model Meeting {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  recordId    BigInt?  @map("record_id") @db.UnsignedBigInt
  studentId   BigInt   @map("student_id") @db.UnsignedBigInt
  parentName  String   @map("parent_name") @db.VarChar(150)
  meetingDate DateTime @map("meeting_date") @db.Date
  meetingTime DateTime @map("meeting_time") @db.Time(0)
  venue       String   @default("Prefect of Discipline Office") @db.VarChar(150)
  status      String   @default("Scheduled") @db.VarChar(30)
  notes       String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(0)
  record      Record?  @relation(fields: [recordId], references: [id], onDelete: Cascade)
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("meetings")
}

model SmsLog {
  id            BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  studentId     BigInt   @map("student_id") @db.UnsignedBigInt
  recordId      BigInt?  @map("record_id") @db.UnsignedBigInt
  recipientName String?  @map("recipient_name") @db.VarChar(150)
  phoneNumber   String   @map("phone_number") @db.VarChar(30)
  message       String   @db.Text
  status        String   @default("Sent") @db.VarChar(20)
  sentAt        DateTime @default(now()) @map("sent_at") @db.DateTime(0)
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  record        Record?  @relation(fields: [recordId], references: [id], onDelete: SetNull)

  @@map("sms_logs")
}

model Session {
  id        String   @id @default(cuid()) @db.VarChar(30)
  tokenHash String   @unique @map("token_hash") @db.Char(64)
  userId    BigInt   @map("user_id") @db.UnsignedBigInt
  role      String   @db.VarChar(20)
  expiresAt DateTime @map("expires_at") @db.DateTime(0)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)
  @@index([expiresAt])
  @@map("sessions")
}
