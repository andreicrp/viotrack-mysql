{
  "name": "viotrack-react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n API,WEB,LANGUAGETOOL \"npm:server:dev\" \"vite\" \"npm:languagetool:dev\"",
    "languagetool:dev": "node scripts/start-languagetool.mjs",
    "build": "prisma generate && vite build",
    "build:server": "prisma generate && tsc -p server/tsconfig.json",
    "lint": "oxlint",
    "test": "vitest run",
    "server:dev": "tsx watch server/index.ts",
    "server:start": "node dist-server/server/index.js",
    "preview": "vite preview",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "cap:sync": "vite build && npx cap sync android",
    "cap:open": "npx cap open android",
    "build:apk": "vite build && npx cap sync android && cd android && .\\gradlew.bat assembleRelease",
    "build:debug": "vite build && npx cap sync android && cd android && .\\gradlew.bat assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/share": "^8.0.3",
    "@capacitor/status-bar": "^8.0.3",
    "@capgo/capacitor-printer": "^8.1.8",
    "@prisma/adapter-mariadb": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.3",
    "canvas-confetti": "^1.9.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "html5-qrcode": "^2.3.8",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.48.0",
    "mariadb": "^3.5.4",
    "pdfjs-dist": "^6.4.299",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.6",
    "oxlint": "^1.81.0",
    "prisma": "^7.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "allowScripts": {
    "@prisma/client@7.10.1": true,
    "@prisma/engines@7.10.1": true,
    "prisma@7.10.1": true
  }
}
