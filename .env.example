# MySQL connection for the Express API / Prisma
DATABASE_URL="mysql://viotrack:change-me@localhost:3306/viotrack_db"
PORT=3000

# Comma-separated browser origins allowed to call the API
FRONTEND_ORIGINS=http://localhost:5173,capacitor://localhost,https://localhost

# Leave empty for same-origin web deployments. For a separately hosted API,
# set this to its HTTPS origin before building the frontend.
VITE_API_BASE_URL=
# Optional trusted LanguageTool endpoint used by the server-side API proxy
# LANGUAGETOOL_API_URL=http://127.0.0.1:8010/v2/check
# Temporary IT contact used by the Forgot password dialog; replace with the school's address.
VITE_IT_SUPPORT_EMAIL="it@viotrack.edu"

# One-time initial administrator provisioning (set before running prisma:seed)
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
QR_HMAC_SECRET=

# iProgSMS / iProgTech Gateway API Configuration
IPROGSMS_API_TOKEN=
IPROGSMS_ENDPOINT=https://sms.iprogtech.com/api/v1/sms_messages
IPROGSMS_SENDER_NAME=PHCM VioTrack

# Optional Public Web App URL for external QR code scanner redirects
# VITE_APP_URL=https://viotrack.example.com
